    "import numpy as np\n",
    "a = np.array([1, 2, 3, 4, 5, 4, 4])\n",
    "print(np.where(a == 4))\n",
    "print(np.where(a % 2 == 0))\n",
    "b = np.array([6, 7, 8, 9])\n",
    "print(np.searchsorted(b, 7), np.searchsorted(b, 7, side='right'))\n",
    "print(np.searchsorted(b, [2, 7, 9]))\n",
    "print(np.argmax(a), np.argmin(a))"
   ]
