   "source": [
    "from collections import defaultdict\n",
    "\n",
    "L = [\"ate\", \"eat\", \"tea\", \"bat\", \"nat\", \"tan\"]\n",
    "\n",
    "groups = defaultdict(list)\n",
    "\n",
    "for word in L:\n",
    "    key = \"\".join(sorted(word))\n",
    "    groups[key].append(word)\n",
    "\n",
    "o = list(groups.values())\n",
    "\n",
    "print(o)"
   ]
  }
