   "source": [
    "from collections import defaultdict\n",
    "\n",
    "nums = [1, 1, 1, 2, 3]\n",
    "k = 2\n",
    "\n",
    "groups = defaultdict(list)\n",
    "\n",
    "for num in nums:\n",
    "    groups[num].append(num)\n",
    "\n",
    "o = list(groups.values())\n",
    "\n",
    "result = [group[0] for group in o[:k]]\n",
    "\n",
    "print(result)"
   ]
  }
 ],
