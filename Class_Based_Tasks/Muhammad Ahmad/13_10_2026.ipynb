    "t = 2\n",
    "def sorting(num):\n",
    "    list = [1,3,4,5,6]\n",
    "    if num in list:\n",
    "        return list.index(num)\n",
    "    index = num-1\n",
    "    list.insert(index,num)\n",
    "    return index\n",
    "num = sorting(t)\n",
    "print(num)"
   ]
